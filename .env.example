# ==========================================
# Fielder 시설관리운영시스템 실운영 환경변수 (.env.example)
# ==========================================

# [필수] 실행 환경 및 서비스 기본 URL
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://fielder.kr

# [필수] 슈퍼 관리자 계정 (초기 로그인용, 반드시 강력한 비밀번호 사용)
SUPER_ADMIN_EMAIL=admin@fielder.kr
SUPER_ADMIN_PASSWORD=여기에_강력한_슈퍼관리자_비밀번호_입력

# [필수] 영구 데이터베이스 (Railway PostgreSQL 연결 문자열)
# - 설정 시 PostgreSQL에 자동 연결되며, 미설정(로컬 개발) 시 SQLite(fms.db)로 폴백합니다.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# [선택] 데모 데이터 시드 여부 (실운영 환경에서는 false 권장)
SEED_DEMO=false

# [선택] Cloudflare R2 이미지 스토리지 (S3 호환)
# - 5개 항목이 모두 설정되면 현장/민원 사진을 R2에 업로드하고 DB에는 URL만 저장합니다.
R2_ENDPOINT=https://여기에_계정ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=여기에_R2_액세스_키
R2_SECRET_ACCESS_KEY=여기에_R2_시크릿_키
R2_BUCKET=fielder-media
R2_PUBLIC_URL=https://media.fielder.kr

# [선택] 실제 문자(SMS) 발송 연동 (알리고 aligo 또는 솔라피 solapi)
# - 미설정 시 개발용 테스트 모드(mock)로 동작합니다.
SMS_PROVIDER=aligo
SMS_API_KEY=여기에_SMS_API_KEY
SMS_API_SECRET=여기에_SMS_API_SECRET
SMS_USER_ID=여기에_알리고_아이디_선택
SMS_SENDER=01012345678
